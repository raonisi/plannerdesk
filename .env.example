# PlannerDesk local configuration
# Copy to .env.local for local development. Do not commit real secrets.

NEXT_PUBLIC_APP_NAME=PlannerDesk
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL connection strings.
# Configure real values only in Railway Variables or local ignored env files.
# Never commit real connection strings, passwords, or tokens to git.
DATABASE_URL=
DIRECT_URL=

# Auth.js (NextAuth v5) configuration.
# AUTH_SECRET is required in production for signing tokens and cookies.
# Generate a random value: npx auth secret
# Set real values only in Railway Variables or .env.local (never commit).
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional NextAuth v4 compatibility (only if needed for migration):
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Verified answer assistant allowlist beta (PR-98 / PR-99-B).
# Default OFF when unset. Never set true without operator sign-off + allowlist.
# ANSWER_ASSISTANT_VERIFIED_BETA_ENABLED=false
# Legacy alias (also requires allowlist when true):
# ANSWER_ASSISTANT_VERIFIED_PREVIEW=false
# Comma-separated User.id values only — no email or PII.
# ANSWER_ASSISTANT_VERIFIED_ALLOWLIST=

# Answer assistant durable rate limit / usage audit (PR-99-A).
# Default: durable in non-test runtimes; memory in NODE_ENV=test.
# ANSWER_ASSISTANT_RATE_LIMIT_BACKEND=durable
# ANSWER_ASSISTANT_USAGE_AUDIT_BACKEND=durable
# ANSWER_ASSISTANT_RATE_LIMIT_PER_MINUTE=3
# ANSWER_ASSISTANT_RATE_LIMIT_PER_DAY=20
# ANSWER_ASSISTANT_BLOCKED_REQUEST_LIMIT_PER_DAY=5
# ANSWER_ASSISTANT_PROMPT_INJECTION_LIMIT_PER_DAY=3
# ANSWER_ASSISTANT_PROVIDER_ERROR_LIMIT_PER_DAY=5

# Answer assistant retention / cleanup (PR-102). Execute disabled by default.
# ANSWER_ASSISTANT_RATE_LIMIT_BUCKET_RETENTION_DAYS=30
# ANSWER_ASSISTANT_RATE_LIMIT_STATE_RETENTION_DAYS=30
# ANSWER_ASSISTANT_USAGE_AUDIT_RETENTION_DAYS=180
# ANSWER_ASSISTANT_FEEDBACK_RETENTION_DAYS=365
# ANSWER_ASSISTANT_FEEDBACK_CRITICAL_RETENTION_DAYS=730
# ANSWER_ASSISTANT_CLEANUP_LOG_RETENTION_DAYS=365
# ANSWER_ASSISTANT_CLEANUP_EXECUTE_ENABLED=false
# PR-103 beta expansion decision thresholds (ADMIN report only)
# ANSWER_ASSISTANT_BETA_DECISION_MIN_OPERATION_DAYS=14
# ANSWER_ASSISTANT_BETA_DECISION_MIN_REQUESTS=20
# ANSWER_ASSISTANT_BETA_DECISION_CLEANUP_OVERDUE_DAYS=90
# ANSWER_ASSISTANT_BETA_DECISION_FEEDBACK_BACKLOG_MAX=15
# PR-104-C limited allowlist expansion plan (report only — no auto apply)
# ANSWER_ASSISTANT_EXPANSION_WAVE1_MAX_ADD=3
# ANSWER_ASSISTANT_EXPANSION_WAVE2_CUMULATIVE_CAP=10
# ANSWER_ASSISTANT_EXPANSION_CANDIDATE_PREVIEW_LIMIT=25

# Work-tools storage proxy (planner-gated API only).
# Set in Railway Variables or local ignored env files — never commit real values.
# WORK_TOOLS_SUPABASE_URL=
# WORK_TOOLS_SUPABASE_ANON_KEY=
# WORK_TOOLS_FIREBASE_BUCKET=

# Codex/local operator Firebase upload helpers.
# Used by scripts/firebase-upload.mjs and mcp/firebase-storage-server.mjs only.
# Never expose these to the app UI or commit real values.
# FIREBASE_UPLOAD_BUCKET=
# FIREBASE_UPLOAD_CLIENT_EMAIL=
# FIREBASE_UPLOAD_PRIVATE_KEY=


# Google OAuth (required for admin sign-in in production):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=
# AUTH_NAVER_ID=
# AUTH_NAVER_SECRET=
