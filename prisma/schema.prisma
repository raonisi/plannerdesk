// PlannerDesk Prisma schema for Auth.js and Insurer Directory.
//
// Refer to docs/AUTH_DATABASE_SCHEMA_PLAN.md and docs/ADMIN_CRUD_ARCHITECTURE.md for details.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  super_admin
  content_admin
  moderator
  verified_planner
  anonymous_public
}

enum UserStatus {
  active
  invited
  suspended
  disabled
}

enum VerificationStatus {
  unverified
  pending
  verified
  draft
  needs_review
}

enum InsurerCategory {
  life
  non_life
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  role               Role               @default(anonymous_public)
  status             UserStatus         @default(active)
  verificationStatus VerificationStatus @default(unverified)
  accounts           Account[]
  sessions           Session[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Insurer {
  id                 String             @id @default(cuid())
  name               String
  category           InsurerCategory
  officialWebsiteUrl String?
  plannerPortalUrl   String?
  claimPageUrl       String?
  customerCenterPhone String?
  faxNumber          String?
  mailingAddress     String?
  notes              String?
  verificationStatus VerificationStatus @default(draft)
  lastVerifiedAt     DateTime?
  isPublished        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdById        String?
  updatedById        String?

  @@index([category])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([name])
}
