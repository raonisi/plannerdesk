// PlannerDesk Prisma schema for Auth.js and Insurer Directory.
//
// Refer to docs/AUTH_DATABASE_SCHEMA_PLAN.md and docs/ADMIN_CRUD_ARCHITECTURE.md for details.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  super_admin
  content_admin
  moderator
  verified_planner
  anonymous_public
}

enum UserStatus {
  active
  invited
  suspended
  disabled
}

enum VerificationStatus {
  unverified
  pending
  verified
  draft
  needs_review
}

enum InsurerCategory {
  life
  non_life
}

enum ClaimFaxHandlingType {
  fax
  call_center_individual
  unavailable
  unknown
}

enum CardPaymentStatus {
  available
  unavailable
  conditional
  unknown
}

enum ClaimDocumentCategory {
  actual_expense
  diagnosis
  surgery
  hospitalization
  outpatient
  fracture
  driver
  death
  disability
  other
}

enum KnowledgeArticleStatus {
  draft
  needs_review
  verified
  archived
  rejected
}

enum KnowledgeArticleCategory {
  claim
  underwriting
  cancellation
  disclosure
  customer_message
  operation_safety
  plannerdesk_usage
}

enum KnowledgeArticleType {
  faq
  practical_standard
  checklist
  message_sample
  link_guide
  safety_boundary
}

enum KnowledgeRiskLevel {
  low
  medium
  high
  blocked
}

enum KnowledgeSourceType {
  internal
  official
  insurer
  regulator
  mixed
}

// Disclosure / terms link library (PR-71 schema only; admin CRUD and public fetch in later PRs).
enum DisclosureLinkCategory {
  product_disclosure
  policy_terms
  claim_disclosure
  insurer_notice
  insurer_official_materials
  insurance_association
  regulator
  claim_compensation_reference
  education_practice_reference
  customer_guide
  other
}

enum DisclosureLinkTargetType {
  insurer
  regulator
  association
  internal
  other
}

enum DisclosureLinkStatus {
  draft
  needs_review
  published
  archived
}

// Customer message templates (PR-73 schema only; admin CRUD and public fetch in PR-74+).
enum MessageTemplateCategory {
  greeting
  follow_up
  appointment
  policy_review
  claim_guide
  contract_maintenance
  cancellation_defense
  rebalancing
  customer_care
  notice
  other
}

enum MessageTemplateChannel {
  kakao
  sms
  phone_script
  email
  blog
  threads
  instagram
  general
}

enum MessageTemplateAudienceType {
  new_customer
  existing_customer
  dormant_customer
  claim_customer
  cancellation_risk
  referral
  general
}

enum MessageTemplateTone {
  formal
  warm
  concise
  consultative
  reassuring
  neutral
  professional
  careful
  calm
}

enum MessageTemplateRiskLevel {
  low
  medium
  high
}

enum MessageTemplateStatus {
  draft
  needs_review
  published
  archived
}

// Public correction / feedback queue (PR-79 schema only; submit action PR-80, admin inbox PR-81).
// No PII, medical, contract, file, payout, or auto-apply fields — see docs/PR-78-CORRECTIONREQUEST-POLICY.md.
enum CorrectionTargetType {
  insurer
  claim_document
  disclosure_link
  message_template
  knowledge_article
  general
}

enum CorrectionRequestType {
  broken_link
  outdated_info
  typo
  wrong_category
  document_requirement_update
  disclosure_update
  message_template_feedback
  knowledge_article_feedback
  other
}

enum CorrectionRequestStatus {
  new
  triaged
  needs_redaction
  accepted
  rejected
  applied
  archived
  deleted
}

enum CorrectionRequestPriority {
  low
  normal
  high
  urgent
}

// Planner verification queue (PR-87 schema only; admin UI PR-88, public form later).
// No PII, license images, OCR, auto-approve, or external lookup — see docs/PR-86-PLANNER-VERIFICATION-POLICY.md.
enum PlannerVerificationStatus {
  pending
  under_review
  approved
  rejected
  suspended
  expired
  deleted
}

enum PlannerType {
  life
  non_life
  both
  ga
  agency
  other
}

enum PlannerCareerRange {
  under_1_year
  one_to_three_years
  three_to_five_years
  five_to_ten_years
  over_ten_years
  not_disclosed
}

enum PlannerLicenseScope {
  life_only
  non_life_only
  life_and_non_life
  third_insurance
  unknown
  not_disclosed
}

enum PlannerBusinessChannel {
  face_to_face
  online
  telemarketing
  corporate
  mixed
  other
  not_disclosed
}

// Community post schema (PR-90 schema only; public/admin UI in PR-91+).
// Never store customer PII, medical data, claim docs, files, OCR, or payout judgments.
enum CommunityPostCategory {
  notice
  field_tips
  claim_guide
  system_links
  knowledge_qa
  script_review
  community_qa
  other
}

enum CommunityPostStatus {
  draft
  published
  under_review
  blinded
  archived
  deleted
}

enum CommunityPostVisibility {
  public
  verified_only
  admin_only
}

enum CommunityReportReason {
  personal_info
  medical_info
  contract_info
  claim_document
  claim_judgment
  loss_adjustment
  product_solicitation
  fear_marketing
  spam
  external_contact
  abuse
  misinformation
  duplicate
  other
}

enum CommunityReportStatus {
  new
  reviewing
  accepted
  rejected
  closed
  deleted
}

// Answer assistant operational safety (PR-99-A). Metadata only — no prompt/draft/raw output.
enum AnswerAssistantUsageAudience {
  admin
  verified_planner
}

enum AnswerAssistantUsageOutcome {
  success
  blocked
}

// Beta safety feedback (PR-101). Structured signals only — no prompt/draft/PII.
enum AnswerAssistantFeedbackType {
  post_session
  blocked_experience
  safety_concern
  ui_understanding
  other_signal
}

enum AnswerAssistantSafetySignal {
  blocking_felt_wrong
  evidence_too_weak
  output_too_assertive
  missing_disclaimer
  prompt_injection_risk
  privacy_risk
  none
}

enum AnswerAssistantFeedbackSeverity {
  low
  medium
  high
}

enum AnswerAssistantFeedbackUsefulness {
  not_useful
  partial
  helpful
  not_applicable
}

enum AnswerAssistantFeedbackNoteCategory {
  blocking
  evidence
  output_safety
  ui_copy
  rate_limit
  other
}

enum AnswerAssistantFeedbackReviewStatus {
  new
  triaged
  incident_candidate
  dismissed
  resolved
}

model User {
  id                                  String                         @id @default(cuid())
  name                                String?
  email                               String?                        @unique
  emailVerified                       DateTime?
  image                               String?
  role                                Role                           @default(anonymous_public)
  status                              UserStatus                     @default(active)
  verificationStatus                  VerificationStatus             @default(unverified)
  accounts                            Account[]
  sessions                            Session[]
  resolvedCorrectionRequests          CorrectionRequest[]            @relation("CorrectionRequestResolvedBy")
  plannerVerifications                PlannerVerification[]          @relation("PlannerVerificationUser")
  reviewedPlannerVerifications        PlannerVerification[]          @relation("PlannerVerificationReviewer")
  authoredCommunityPosts              CommunityPost[]                @relation("CommunityPostAuthor")
  reviewedCommunityPosts              CommunityPost[]                @relation("CommunityPostReviewer")
  blindedCommunityPosts               CommunityPost[]                @relation("CommunityPostBlindedBy")
  deletedCommunityPosts               CommunityPost[]                @relation("CommunityPostDeletedBy")
  submittedCommunityReports           CommunityReport[]              @relation("CommunityReportReporter")
  reviewedCommunityReports            CommunityReport[]              @relation("CommunityReportReviewer")
  answerAssistantRateLimit            AnswerAssistantRateLimitState?
  answerAssistantUsageAudits          AnswerAssistantUsageAudit[]
  answerAssistantBetaFeedbacks        AnswerAssistantBetaFeedback[]  @relation("AnswerAssistantBetaFeedbackUser")
  reviewedAnswerAssistantBetaFeedback AnswerAssistantBetaFeedback[]  @relation("AnswerAssistantBetaFeedbackReviewer")
  createdAt                           DateTime                       @default(now())
  updatedAt                           DateTime                       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Insurer {
  id                            String               @id @default(cuid())
  name                          String
  category                      InsurerCategory
  officialWebsiteUrl            String?
  plannerPortalUrl              String?
  systemUrl                     String?
  claimPageUrl                  String?
  customerCenterPhone           String?
  callMonitoringPhone           String?
  helpdeskPhone                 String?
  faxNumber                     String?
  mailingAddress                String?
  cardPaymentInitialAvailable   Boolean?
  cardPaymentRecurringAvailable Boolean?
  cardPaymentStatus             CardPaymentStatus    @default(unknown)
  cardPaymentNote               String?
  claimFaxNumber                String?
  claimFaxHandlingType          ClaimFaxHandlingType @default(unknown)
  registeredMailAddress         String?
  claimFormUrl                  String?
  termsUrl                      String?
  sourceNote                    String?
  notes                         String?
  verificationStatus            VerificationStatus   @default(draft)
  lastVerifiedAt                DateTime?
  isPublished                   Boolean              @default(false)
  sortOrder                     Int                  @default(0)
  isFeatured                    Boolean              @default(false)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  createdById                   String?
  updatedById                   String?

  claimDocuments  ClaimDocument[]
  disclosureLinks DisclosureLink[]

  @@index([category])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([name])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([cardPaymentStatus])
  @@index([claimFaxHandlingType])
}

model ClaimDocument {
  id                      String                @id @default(cuid())
  title                   String
  slug                    String                @unique
  category                ClaimDocumentCategory
  insurerId               String?
  insurer                 Insurer?              @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  summary                 String?
  requiredDocuments       String?
  optionalDocuments       String?
  claimFormUrl            String?
  officialSourceUrl       String?
  customerMessageTemplate String?
  cautionNote             String?
  verificationStatus      VerificationStatus    @default(draft)
  lastVerifiedAt          DateTime?
  isPublished             Boolean               @default(false)
  sortOrder               Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  createdById             String?
  updatedById             String?

  @@index([category])
  @@index([insurerId])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([sortOrder])
}

// Knowledge archive articles for future admin CRUD and DB-backed /knowledge.
// Public read and Admin UI are out of scope for PR-KNOW-DB-01.
model KnowledgeArticle {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String
  content String @db.Text

  category  KnowledgeArticleCategory
  type      KnowledgeArticleType
  riskLevel KnowledgeRiskLevel       @default(medium)
  status    KnowledgeArticleStatus   @default(draft)

  isPublished Boolean @default(false)
  aiUsable    Boolean @default(false)

  sourceType      KnowledgeSourceType @default(internal)
  sourceTitle     String?
  sourceUrl       String?
  sourceCheckedAt DateTime?

  workflowLabel   String?
  tags            String[] @default([])
  safeCopy        String?  @db.Text
  forbiddenClaims String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  createdById  String?
  updatedById  String?
  reviewedById String?

  @@index([status])
  @@index([isPublished])
  @@index([category])
  @@index([type])
  @@index([riskLevel])
  @@index([aiUsable])
  @@index([slug])
}

// Official disclosure / policy links for /disclosure-links (DB-backed in PR-72+).
// Public visibility (PR-75): isPublished=true AND status=published only.
model DisclosureLink {
  id               String                   @id @default(cuid())
  title            String
  description      String                   @db.Text
  url              String
  category         DisclosureLinkCategory
  targetType       DisclosureLinkTargetType @default(other)
  insurerId        String?
  insurer          Insurer?                 @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  status           DisclosureLinkStatus     @default(draft)
  isPublished      Boolean                  @default(false)
  sourceName       String?
  isOfficialSource Boolean                  @default(false)
  lastVerifiedAt   DateTime?
  publishedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  sortOrder        Int                      @default(0)
  adminMemo        String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdById      String?
  updatedById      String?

  @@index([category])
  @@index([targetType])
  @@index([insurerId])
  @@index([status])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([lastVerifiedAt])
}

// Planner-facing customer message templates for /message-templates (DB-backed in PR-74+).
// Public visibility (PR-76): isPublished=true AND status=published AND isInternalOnly=false.
// Template placeholders only — no customer PII, medical, contract, or payout data in rows.
model MessageTemplate {
  id               String                      @id @default(cuid())
  title            String
  description      String                      @db.Text
  body             String                      @db.Text
  category         MessageTemplateCategory
  channel          MessageTemplateChannel      @default(general)
  audienceType     MessageTemplateAudienceType @default(general)
  useCase          String                      @db.Text
  tone             MessageTemplateTone         @default(neutral)
  status           MessageTemplateStatus       @default(draft)
  isPublished      Boolean                     @default(false)
  isInternalOnly   Boolean                     @default(false)
  riskLevel        MessageTemplateRiskLevel    @default(medium)
  safeCopy         String?                     @db.Text
  forbiddenClaims  String[]                    @default([])
  complianceNote   String?                     @db.Text
  allowedVariables String[]                    @default([])
  sortOrder        Int                         @default(0)
  reviewedAt       DateTime?
  reviewedById     String?
  publishedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  createdById      String?
  updatedById      String?

  @@index([category])
  @@index([channel])
  @@index([audienceType])
  @@index([tone])
  @@index([status])
  @@index([isPublished])
  @@index([isInternalOnly])
  @@index([riskLevel])
  @@index([sortOrder])
}

// Operator-reviewed public feedback queue. Never auto-applies to published content.
// targetId is interpreted with targetType (no polymorphic FK to content tables).
model CorrectionRequest {
  id                    String                    @id @default(cuid())
  targetType            CorrectionTargetType
  targetId              String?
  requestType           CorrectionRequestType
  title                 String
  message               String                    @db.Text
  status                CorrectionRequestStatus   @default(new)
  priority              CorrectionRequestPriority @default(normal)
  containsSensitiveData Boolean                   @default(false)
  redactionRequired     Boolean                   @default(false)
  redactedAt            DateTime?
  resolvedAt            DateTime?
  resolvedById          String?
  resolvedBy            User?                     @relation("CorrectionRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  adminMemo             String?                   @db.Text
  retentionUntil        DateTime?
  deletedAt             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status])
  @@index([targetType])
  @@index([requestType])
  @@index([priority])
  @@index([containsSensitiveData])
  @@index([redactionRequired])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([status, createdAt])
  @@index([targetType, createdAt])
  @@index([redactionRequired, createdAt])
}

// Admin-reviewed planner verification. Grants internal RBAC only — not legal credential proof.
// approved status does not auto-update User.role; PR-88 super_admin action required.
model PlannerVerification {
  id                         String                    @id @default(cuid())
  userId                     String
  user                       User                      @relation("PlannerVerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  status                     PlannerVerificationStatus @default(pending)
  displayName                String
  plannerType                PlannerType
  affiliationName            String?
  activityRegion             String
  careerRange                PlannerCareerRange
  licenseScope               PlannerLicenseScope       @default(not_disclosed)
  businessChannel            PlannerBusinessChannel    @default(not_disclosed)
  verificationNote           String?                   @db.Text
  containsSensitiveData      Boolean                   @default(false)
  requestedAt                DateTime                  @default(now())
  reviewedAt                 DateTime?
  reviewedById               String?
  reviewedBy                 User?                     @relation("PlannerVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminMemo                  String?                   @db.Text
  rejectionReason            String?                   @db.Text
  userFacingRejectionSummary String?
  suspendedAt                DateTime?
  deletedAt                  DateTime?
  retentionUntil             DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([plannerType])
  @@index([careerRange])
  @@index([requestedAt])
  @@index([reviewedAt])
  @@index([deletedAt])
  @@index([containsSensitiveData])
  @@index([status, requestedAt])
  @@index([userId, status])
}

// Community posts authored by verified planners/admins (RBAC checks in PR-91 server layer).
// Visibility and status guard public exposure; no file attachment fields by design.
model CommunityPost {
  id          String                  @id @default(cuid())
  authorId    String
  author      User                    @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category    CommunityPostCategory
  title       String
  content     String                  @db.Text
  status      CommunityPostStatus     @default(draft)
  visibility  CommunityPostVisibility @default(verified_only)
  isPinned    Boolean                 @default(false)
  isBlind     Boolean                 @default(false)
  blindReason CommunityReportReason?

  blindReasonText String?   @db.Text
  blindedAt       DateTime?
  blindedById     String?
  blindedBy       User?     @relation("CommunityPostBlindedBy", fields: [blindedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("CommunityPostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?     @relation("CommunityPostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  adminMemo       String?   @db.Text
  reportCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reports CommunityReport[]

  @@index([authorId])
  @@index([category])
  @@index([status])
  @@index([visibility])
  @@index([isPinned])
  @@index([isBlind])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@index([visibility, status, createdAt])
  @@index([authorId, createdAt])
  @@index([isBlind, status, createdAt])
}

// Minimal manual moderation report queue for community posts.
// No screenshots/files/OCR or auto-moderation result fields.
model CommunityReport {
  id           String                @id @default(cuid())
  postId       String
  post         CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User                  @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       CommunityReportReason
  status       CommunityReportStatus @default(new)
  message      String?               @db.Text
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                 @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminMemo    String?               @db.Text
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([postId, reporterId, reason])
  @@index([postId])
  @@index([reporterId])
  @@index([reason])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedAt])
  @@index([postId, status])
  @@index([status, createdAt])
  @@index([reporterId, postId])
}

// Per-user durable rate limit counters for verified answer assistant (PR-99-A).
model AnswerAssistantRateLimitState {
  userId                    String    @id
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  minuteWindowStart         DateTime
  minuteCount               Int       @default(0)
  dayWindowStart            DateTime
  dayCount                  Int       @default(0)
  abuseWindowStart          DateTime
  blockedCountToday         Int       @default(0)
  promptInjectionCountToday Int       @default(0)
  providerErrorCountToday   Int       @default(0)
  cooldownUntil             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

// Minimal usage audit — blockedReason/outcome metadata only (PR-99-A).
model AnswerAssistantUsageAudit {
  id                  String                        @id @default(cuid())
  userId              String
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience            AnswerAssistantUsageAudience
  outcome             AnswerAssistantUsageOutcome
  requestPurpose      String?
  blockedReason       String?
  candidateCount      Int?
  evidenceSourceIds   Json?
  outputSafetyBlocked Boolean                       @default(false)
  providerConfigured  Boolean?
  providerErrorCode   String?
  rateLimitBlocked    Boolean                       @default(false)
  isAdminTester       Boolean                       @default(false)
  createdAt           DateTime                      @default(now())
  betaFeedbacks       AnswerAssistantBetaFeedback[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([blockedReason])
}

// Structured beta safety feedback linked to usage audit metadata (PR-101).
model AnswerAssistantBetaFeedback {
  id           String                               @id @default(cuid())
  usageAuditId String?
  usageAudit   AnswerAssistantUsageAudit?           @relation(fields: [usageAuditId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?                                @relation("AnswerAssistantBetaFeedbackUser", fields: [userId], references: [id], onDelete: SetNull)
  feedbackType AnswerAssistantFeedbackType
  safetySignal AnswerAssistantSafetySignal?
  severity     AnswerAssistantFeedbackSeverity      @default(low)
  usefulness   AnswerAssistantFeedbackUsefulness?
  noteCategory AnswerAssistantFeedbackNoteCategory?
  shortNote    String?                              @db.VarChar(120)
  adminStatus  AnswerAssistantFeedbackReviewStatus  @default(new)
  adminMemo    String?                              @db.VarChar(500)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?                                @relation("AnswerAssistantBetaFeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                             @default(now())
  updatedAt    DateTime                             @updatedAt

  @@index([usageAuditId])
  @@index([userId])
  @@index([feedbackType])
  @@index([safetySignal])
  @@index([severity])
  @@index([adminStatus])
  @@index([createdAt])
}
