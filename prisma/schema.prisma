// PlannerDesk Prisma schema for Auth.js and Insurer Directory.
//
// Refer to docs/AUTH_DATABASE_SCHEMA_PLAN.md and docs/ADMIN_CRUD_ARCHITECTURE.md for details.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  super_admin
  content_admin
  moderator
  verified_planner
  anonymous_public
}

enum UserStatus {
  active
  invited
  suspended
  disabled
}

enum VerificationStatus {
  unverified
  pending
  verified
  draft
  needs_review
}

enum InsurerCategory {
  life
  non_life
}

enum ClaimFaxHandlingType {
  fax
  call_center_individual
  unavailable
  unknown
}

enum CardPaymentStatus {
  available
  unavailable
  conditional
  unknown
}

enum ClaimDocumentCategory {
  actual_expense
  diagnosis
  surgery
  hospitalization
  outpatient
  fracture
  driver
  death
  disability
  other
}

enum KnowledgeArticleStatus {
  draft
  needs_review
  verified
  archived
  rejected
}

enum KnowledgeArticleCategory {
  claim
  underwriting
  cancellation
  disclosure
  customer_message
  operation_safety
  plannerdesk_usage
}

enum KnowledgeArticleType {
  faq
  practical_standard
  checklist
  message_sample
  link_guide
  safety_boundary
}

enum KnowledgeRiskLevel {
  low
  medium
  high
  blocked
}

enum KnowledgeSourceType {
  internal
  official
  insurer
  regulator
  mixed
}

// Disclosure / terms link library (PR-71 schema only; admin CRUD and public fetch in later PRs).
enum DisclosureLinkCategory {
  product_disclosure
  policy_terms
  claim_disclosure
  insurer_notice
  insurer_official_materials
  insurance_association
  regulator
  claim_compensation_reference
  education_practice_reference
  customer_guide
  other
}

enum DisclosureLinkTargetType {
  insurer
  regulator
  association
  internal
  other
}

enum DisclosureLinkStatus {
  draft
  needs_review
  published
  archived
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  role               Role               @default(anonymous_public)
  status             UserStatus         @default(active)
  verificationStatus VerificationStatus @default(unverified)
  accounts           Account[]
  sessions           Session[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Insurer {
  id                            String               @id @default(cuid())
  name                          String
  category                      InsurerCategory
  officialWebsiteUrl            String?
  plannerPortalUrl              String?
  systemUrl                     String?
  claimPageUrl                  String?
  customerCenterPhone           String?
  callMonitoringPhone           String?
  helpdeskPhone                 String?
  faxNumber                     String?
  mailingAddress                String?
  cardPaymentInitialAvailable   Boolean?
  cardPaymentRecurringAvailable Boolean?
  cardPaymentStatus             CardPaymentStatus    @default(unknown)
  cardPaymentNote               String?
  claimFaxNumber                String?
  claimFaxHandlingType          ClaimFaxHandlingType @default(unknown)
  registeredMailAddress         String?
  claimFormUrl                  String?
  termsUrl                      String?
  sourceNote                    String?
  notes                         String?
  verificationStatus            VerificationStatus   @default(draft)
  lastVerifiedAt                DateTime?
  isPublished                   Boolean              @default(false)
  sortOrder                     Int                  @default(0)
  isFeatured                    Boolean              @default(false)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  createdById                   String?
  updatedById                   String?

  claimDocuments  ClaimDocument[]
  disclosureLinks DisclosureLink[]

  @@index([category])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([name])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([cardPaymentStatus])
  @@index([claimFaxHandlingType])
}

model ClaimDocument {
  id                      String                @id @default(cuid())
  title                   String
  slug                    String                @unique
  category                ClaimDocumentCategory
  insurerId               String?
  insurer                 Insurer?              @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  summary                 String?
  requiredDocuments       String?
  optionalDocuments       String?
  claimFormUrl            String?
  officialSourceUrl       String?
  customerMessageTemplate String?
  cautionNote             String?
  verificationStatus      VerificationStatus    @default(draft)
  lastVerifiedAt          DateTime?
  isPublished             Boolean               @default(false)
  sortOrder               Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  createdById             String?
  updatedById             String?

  @@index([category])
  @@index([insurerId])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([sortOrder])
}

// Knowledge archive articles for future admin CRUD and DB-backed /knowledge.
// Public read and Admin UI are out of scope for PR-KNOW-DB-01.
model KnowledgeArticle {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String
  content String @db.Text

  category  KnowledgeArticleCategory
  type      KnowledgeArticleType
  riskLevel KnowledgeRiskLevel       @default(medium)
  status    KnowledgeArticleStatus   @default(draft)

  isPublished Boolean @default(false)
  aiUsable    Boolean @default(false)

  sourceType      KnowledgeSourceType @default(internal)
  sourceTitle     String?
  sourceUrl       String?
  sourceCheckedAt DateTime?

  workflowLabel   String?
  tags            String[] @default([])
  safeCopy        String?  @db.Text
  forbiddenClaims String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  createdById  String?
  updatedById  String?
  reviewedById String?

  @@index([status])
  @@index([isPublished])
  @@index([category])
  @@index([type])
  @@index([riskLevel])
  @@index([aiUsable])
  @@index([slug])
}

// Official disclosure / policy links for /disclosure-links (DB-backed in PR-72+).
// Public visibility (PR-75): isPublished=true AND status=published only.
model DisclosureLink {
  id               String                   @id @default(cuid())
  title            String
  description      String                   @db.Text
  url              String
  category         DisclosureLinkCategory
  targetType       DisclosureLinkTargetType @default(other)
  insurerId        String?
  insurer          Insurer?                 @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  status           DisclosureLinkStatus     @default(draft)
  isPublished      Boolean                  @default(false)
  sourceName       String?
  isOfficialSource Boolean                  @default(false)
  lastVerifiedAt   DateTime?
  publishedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  sortOrder        Int                      @default(0)
  adminMemo        String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdById      String?
  updatedById      String?

  @@index([category])
  @@index([targetType])
  @@index([insurerId])
  @@index([status])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([lastVerifiedAt])
}
