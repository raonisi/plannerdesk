// PlannerDesk Prisma schema for Auth.js and Insurer Directory.
//
// Refer to docs/AUTH_DATABASE_SCHEMA_PLAN.md and docs/ADMIN_CRUD_ARCHITECTURE.md for details.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  super_admin
  content_admin
  moderator
  verified_planner
  anonymous_public
}

enum UserStatus {
  active
  invited
  suspended
  disabled
}

enum VerificationStatus {
  unverified
  pending
  verified
  draft
  needs_review
}

enum InsurerCategory {
  life
  non_life
}

enum ClaimFaxHandlingType {
  fax
  call_center_individual
  unavailable
  unknown
}

enum CardPaymentStatus {
  available
  unavailable
  conditional
  unknown
}

enum ClaimDocumentCategory {
  actual_expense
  diagnosis
  surgery
  hospitalization
  outpatient
  fracture
  driver
  death
  disability
  other
}

enum KnowledgeArticleStatus {
  draft
  needs_review
  verified
  archived
  rejected
}

enum KnowledgeArticleCategory {
  claim
  underwriting
  cancellation
  disclosure
  customer_message
  operation_safety
  plannerdesk_usage
}

enum KnowledgeArticleType {
  faq
  practical_standard
  checklist
  message_sample
  link_guide
  safety_boundary
}

enum KnowledgeRiskLevel {
  low
  medium
  high
  blocked
}

enum KnowledgeSourceType {
  internal
  official
  insurer
  regulator
  mixed
}

// Disclosure / terms link library (PR-71 schema only; admin CRUD and public fetch in later PRs).
enum DisclosureLinkCategory {
  product_disclosure
  policy_terms
  claim_disclosure
  insurer_notice
  insurer_official_materials
  insurance_association
  regulator
  claim_compensation_reference
  education_practice_reference
  customer_guide
  other
}

enum DisclosureLinkTargetType {
  insurer
  regulator
  association
  internal
  other
}

enum DisclosureLinkStatus {
  draft
  needs_review
  published
  archived
}

// Customer message templates (PR-73 schema only; admin CRUD and public fetch in PR-74+).
enum MessageTemplateCategory {
  greeting
  follow_up
  appointment
  policy_review
  claim_guide
  contract_maintenance
  cancellation_defense
  rebalancing
  customer_care
  notice
  other
}

enum MessageTemplateChannel {
  kakao
  sms
  phone_script
  email
  blog
  threads
  instagram
  general
}

enum MessageTemplateAudienceType {
  new_customer
  existing_customer
  dormant_customer
  claim_customer
  cancellation_risk
  referral
  general
}

enum MessageTemplateTone {
  formal
  warm
  concise
  consultative
  reassuring
  neutral
  professional
  careful
  calm
}

enum MessageTemplateRiskLevel {
  low
  medium
  high
}

enum MessageTemplateStatus {
  draft
  needs_review
  published
  archived
}

// Public correction / feedback queue (PR-79 schema only; submit action PR-80, admin inbox PR-81).
// No PII, medical, contract, file, payout, or auto-apply fields — see docs/PR-78-CORRECTIONREQUEST-POLICY.md.
enum CorrectionTargetType {
  insurer
  claim_document
  disclosure_link
  message_template
  knowledge_article
  general
}

enum CorrectionRequestType {
  broken_link
  outdated_info
  typo
  wrong_category
  document_requirement_update
  disclosure_update
  message_template_feedback
  knowledge_article_feedback
  other
}

enum CorrectionRequestStatus {
  new
  triaged
  needs_redaction
  accepted
  rejected
  applied
  archived
  deleted
}

enum CorrectionRequestPriority {
  low
  normal
  high
  urgent
}

model User {
  id                         String              @id @default(cuid())
  name                       String?
  email                      String?             @unique
  emailVerified              DateTime?
  image                      String?
  role                       Role                @default(anonymous_public)
  status                     UserStatus          @default(active)
  verificationStatus         VerificationStatus  @default(unverified)
  accounts                   Account[]
  sessions                   Session[]
  resolvedCorrectionRequests CorrectionRequest[] @relation("CorrectionRequestResolvedBy")
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Insurer {
  id                            String               @id @default(cuid())
  name                          String
  category                      InsurerCategory
  officialWebsiteUrl            String?
  plannerPortalUrl              String?
  systemUrl                     String?
  claimPageUrl                  String?
  customerCenterPhone           String?
  callMonitoringPhone           String?
  helpdeskPhone                 String?
  faxNumber                     String?
  mailingAddress                String?
  cardPaymentInitialAvailable   Boolean?
  cardPaymentRecurringAvailable Boolean?
  cardPaymentStatus             CardPaymentStatus    @default(unknown)
  cardPaymentNote               String?
  claimFaxNumber                String?
  claimFaxHandlingType          ClaimFaxHandlingType @default(unknown)
  registeredMailAddress         String?
  claimFormUrl                  String?
  termsUrl                      String?
  sourceNote                    String?
  notes                         String?
  verificationStatus            VerificationStatus   @default(draft)
  lastVerifiedAt                DateTime?
  isPublished                   Boolean              @default(false)
  sortOrder                     Int                  @default(0)
  isFeatured                    Boolean              @default(false)
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  createdById                   String?
  updatedById                   String?

  claimDocuments  ClaimDocument[]
  disclosureLinks DisclosureLink[]

  @@index([category])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([name])
  @@index([sortOrder])
  @@index([isFeatured])
  @@index([cardPaymentStatus])
  @@index([claimFaxHandlingType])
}

model ClaimDocument {
  id                      String                @id @default(cuid())
  title                   String
  slug                    String                @unique
  category                ClaimDocumentCategory
  insurerId               String?
  insurer                 Insurer?              @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  summary                 String?
  requiredDocuments       String?
  optionalDocuments       String?
  claimFormUrl            String?
  officialSourceUrl       String?
  customerMessageTemplate String?
  cautionNote             String?
  verificationStatus      VerificationStatus    @default(draft)
  lastVerifiedAt          DateTime?
  isPublished             Boolean               @default(false)
  sortOrder               Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  createdById             String?
  updatedById             String?

  @@index([category])
  @@index([insurerId])
  @@index([verificationStatus])
  @@index([isPublished])
  @@index([sortOrder])
}

// Knowledge archive articles for future admin CRUD and DB-backed /knowledge.
// Public read and Admin UI are out of scope for PR-KNOW-DB-01.
model KnowledgeArticle {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String
  content String @db.Text

  category  KnowledgeArticleCategory
  type      KnowledgeArticleType
  riskLevel KnowledgeRiskLevel       @default(medium)
  status    KnowledgeArticleStatus   @default(draft)

  isPublished Boolean @default(false)
  aiUsable    Boolean @default(false)

  sourceType      KnowledgeSourceType @default(internal)
  sourceTitle     String?
  sourceUrl       String?
  sourceCheckedAt DateTime?

  workflowLabel   String?
  tags            String[] @default([])
  safeCopy        String?  @db.Text
  forbiddenClaims String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  createdById  String?
  updatedById  String?
  reviewedById String?

  @@index([status])
  @@index([isPublished])
  @@index([category])
  @@index([type])
  @@index([riskLevel])
  @@index([aiUsable])
  @@index([slug])
}

// Official disclosure / policy links for /disclosure-links (DB-backed in PR-72+).
// Public visibility (PR-75): isPublished=true AND status=published only.
model DisclosureLink {
  id               String                   @id @default(cuid())
  title            String
  description      String                   @db.Text
  url              String
  category         DisclosureLinkCategory
  targetType       DisclosureLinkTargetType @default(other)
  insurerId        String?
  insurer          Insurer?                 @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  status           DisclosureLinkStatus     @default(draft)
  isPublished      Boolean                  @default(false)
  sourceName       String?
  isOfficialSource Boolean                  @default(false)
  lastVerifiedAt   DateTime?
  publishedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  sortOrder        Int                      @default(0)
  adminMemo        String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdById      String?
  updatedById      String?

  @@index([category])
  @@index([targetType])
  @@index([insurerId])
  @@index([status])
  @@index([isPublished])
  @@index([sortOrder])
  @@index([lastVerifiedAt])
}

// Planner-facing customer message templates for /message-templates (DB-backed in PR-74+).
// Public visibility (PR-76): isPublished=true AND status=published AND isInternalOnly=false.
// Template placeholders only — no customer PII, medical, contract, or payout data in rows.
model MessageTemplate {
  id               String                      @id @default(cuid())
  title            String
  description      String                      @db.Text
  body             String                      @db.Text
  category         MessageTemplateCategory
  channel          MessageTemplateChannel      @default(general)
  audienceType     MessageTemplateAudienceType @default(general)
  useCase          String                      @db.Text
  tone             MessageTemplateTone         @default(neutral)
  status           MessageTemplateStatus       @default(draft)
  isPublished      Boolean                     @default(false)
  isInternalOnly   Boolean                     @default(false)
  riskLevel        MessageTemplateRiskLevel    @default(medium)
  safeCopy         String?                     @db.Text
  forbiddenClaims  String[]                    @default([])
  complianceNote   String?                     @db.Text
  allowedVariables String[]                    @default([])
  sortOrder        Int                         @default(0)
  reviewedAt       DateTime?
  reviewedById     String?
  publishedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  createdById      String?
  updatedById      String?

  @@index([category])
  @@index([channel])
  @@index([audienceType])
  @@index([tone])
  @@index([status])
  @@index([isPublished])
  @@index([isInternalOnly])
  @@index([riskLevel])
  @@index([sortOrder])
}

// Operator-reviewed public feedback queue. Never auto-applies to published content.
// targetId is interpreted with targetType (no polymorphic FK to content tables).
model CorrectionRequest {
  id                    String                    @id @default(cuid())
  targetType            CorrectionTargetType
  targetId              String?
  requestType           CorrectionRequestType
  title                 String
  message               String                    @db.Text
  status                CorrectionRequestStatus   @default(new)
  priority              CorrectionRequestPriority @default(normal)
  containsSensitiveData Boolean                   @default(false)
  redactionRequired     Boolean                   @default(false)
  redactedAt            DateTime?
  resolvedAt            DateTime?
  resolvedById          String?
  resolvedBy            User?                     @relation("CorrectionRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  adminMemo             String?                   @db.Text
  retentionUntil        DateTime?
  deletedAt             DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status])
  @@index([targetType])
  @@index([requestType])
  @@index([priority])
  @@index([containsSensitiveData])
  @@index([redactionRequired])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([status, createdAt])
  @@index([targetType, createdAt])
  @@index([redactionRequired, createdAt])
}
