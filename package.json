{
  "name": "plannerdesk",
  "version": "0.1.0",
  "private": true,
  "description": "PlannerDesk is a public B2B SaaS platform for Korean insurance planners.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run lint && npm run test && npm run typecheck && npm run build",
    "db:migrate:deploy": "prisma migrate deploy",
    "release:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "claim-documents:import:dry-run": "node scripts/import-claim-document-candidates.mjs",
    "claim-documents:import:apply": "node scripts/import-claim-document-candidates.mjs --apply",
    "knowledge:import:drafts": "npx tsx scripts/import-knowledge-drafts.ts",
    "firebase:upload": "node scripts/firebase-upload.mjs",
    "smoke:public": "node scripts/smoke-public-routes.mjs",
    "skills:sync": "node scripts/codex-agents-to-cursor-skills.mjs",
    "test": "npm run test:answer-assistant && npm run test:regression",
    "test:answer-assistant": "npx tsx --test tests/answer-assistant/*.test.ts",
    "test:regression": "npm run test:public && npm run test:admin && npm run test:ops:gate && npm run test:work-tools && npm run test:regression:manifest",
    "test:public": "npx tsx --test tests/public/*.test.ts",
    "test:admin": "npx tsx --test tests/admin/*.test.ts",
    "test:ops:gate": "npx tsx --test tests/ops/pr147-data-responsibility-notice.test.ts tests/ops/pr148-ai-limited-beta-policy.test.ts tests/ops/pr149-security-final-audit.test.ts tests/ops/pr154-public-smoke-expansion.test.ts tests/ops/pr155-admin-access-regression.test.ts tests/ops/pr172-beta-review-summary.test.ts tests/ops/pr174-terms-legal-review-prep.test.ts",
    "test:work-tools": "npx tsx --test tests/ops/pr173a-work-tools-access.test.ts tests/ops/pr173b-work-tools-storage-config.test.ts tests/ops/pr173c-claim-boundary.test.ts tests/ops/pr173c-claim-boundary-copy.test.ts tests/ops/firebase-codex-upload-script.test.ts",
    "test:regression:manifest": "npx tsx --test tests/regression/*.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "^16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.0",
    "typescript": "latest"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
